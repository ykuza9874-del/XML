  <!-- realistic JS interactions -->
  <script>
    (function() {
      // --- toggle Buy/Sell tabs ---
      const buyTab = document.getElementById('buyTab');
      const sellTab = document.getElementById('sellTab');
      const tradeButton = document.getElementById('tradeButton');
      const amountInput = document.getElementById('amountInput');
      const totalInput = document.getElementById('totalInput');

      // last price for btc (hardcoded realistic)
      const BTC_PRICE = 63420.80;

      // update total based on amount
      function updateTotal() {
        const amount = parseFloat(amountInput.value) || 0;
        const total = amount * BTC_PRICE;
        totalInput.value = total.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      }

      // switch to buy
      buyTab.addEventListener('click', function() {
        buyTab.classList.add('active');
        sellTab.classList.remove('active');
        tradeButton.textContent = 'Buy BTC';
        tradeButton.style.background = '#2b6eef';
        tradeButton.style.boxShadow = '0 10px 20px -10px #2b6eef';
      });

      // switch to sell
      sellTab.addEventListener('click', function() {
        sellTab.classList.add('active');
        buyTab.classList.remove('active');
        tradeButton.textContent = 'Sell BTC';
        tradeButton.style.background = '#f87171';
        tradeButton.style.boxShadow = '0 10px 20px -10px #f87171';
      });

      // update total when amount changes
      amountInput.addEventListener('input', updateTotal);

      // quick percent buttons (mock)
      const percentButtons = document.querySelectorAll('.quick-percent button');
      percentButtons.forEach(btn => {
        btn.addEventListener('click', function() {
          // demo: set amount based on percentage of assumed 2 BTC balance
          const percentMap = { '25%': 0.25, '50%': 0.5, '75%': 0.75, '100%': 1 };
          const percentage = percentMap[this.textContent.trim()] || 0.1;
          // realistic: set amount to some fraction (total BTC available approx 0.8)
          const available = 0.8;
          const newAmount = (available * percentage).toFixed(4);
          amountInput.value = parseFloat(newAmount);
          updateTotal();
        });
      });

      // initialize total
      updateTotal();

      // trade button click — simulate order
      tradeButton.addEventListener('click', function() {
        const amount = parseFloat(amountInput.value) || 0;
        if (amount <= 0) {
          alert('Please enter a valid amount.');
          return;
        }
        const isBuy = buyTab.classList.contains('active');
        const action = isBuy ? 'Buy' : 'Sell';
        alert(`${action} order placed:\n${amount} BTC at market price.`);
        // (no real backend, just realism)
      });

      // add real-time feel: update total on input already done.
      // also update the last price a tiny bit? not needed.

      // additional realism: hover effect on cards is in css.
      // also make more-btn clickable (mock)
      document.querySelectorAll('.more-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          // do nothing, just visual feedback
        });
      });

      // watchlist rows clickable (console only)
      document.querySelectorAll('.watchlist .coin-row').forEach(row => {
        row.addEventListener('click', function() {
          const coinName = this.querySelector('.coin-name')?.innerText || 'coin';
          console.log(`Selected ${coinName}`);
        });
      });

      // recent trade items subtle feedback
      document.querySelectorAll('.trade-item').forEach(item => {
        item.addEventListener('click', function() {
          // highlight effect
          this.style.backgroundColor = '#19232f';
          setTimeout(() => this.style.backgroundColor = 'transparent', 150);
        });
      });
    })();
  </script>
